@(private)
ICON_BOX := [Icon]u16 {
	.None = 20,
	.Add = 20,
	.Add_Filled = 20,
	.Arrow_Left = 20,
	.Arrow_Left_Filled = 20,
	.Arrow_Right = 20,
	.Arrow_Right_Filled = 20,
	.Calendar = 20,
	.Calendar_Filled = 20,
	.Checkmark = 20,
	.Checkmark_Circle = 20,
	.Checkmark_Circle_Filled = 20,
	.Checkmark_Filled = 20,
	.Chevron_Down = 20,
	.Chevron_Down_Filled = 20,
	.Chevron_Left = 20,
	.Chevron_Left_Filled = 20,
	.Chevron_Right = 20,
	.Chevron_Right_Filled = 20,
	.Chevron_Up = 20,
	.Chevron_Up_Filled = 20,
	.Copy = 20,
	.Copy_Filled = 20,
	.Delete = 20,
	.Delete_Filled = 20,
	.Dismiss = 20,
	.Dismiss_Filled = 20,
	.Edit = 20,
	.Edit_Filled = 20,
	.Error_Circle = 20,
	.Error_Circle_Filled = 20,
	.Info = 20,
	.Info_Filled = 20,
	.More_Horizontal = 20,
	.More_Horizontal_Filled = 20,
	.Navigation = 20,
	.Navigation_Filled = 20,
	.Open = 20,
	.Open_Filled = 20,
	.Save = 20,
	.Save_Filled = 20,
	.Search = 20,
	.Search_Filled = 20,
	.Send = 20,
	.Send_Filled = 20,
	.Settings = 20,
	.Settings_Filled = 20,
