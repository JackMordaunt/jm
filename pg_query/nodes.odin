// decode_node reads one single-key node object. ok is false for a tag this
// build has no type for, which parse turns into a Fault.
decode_node :: proc(v: json.Value, allocator: mem.Allocator) -> (node: Node, ok: bool) {
	obj := v.(json.Object) or_return
	for tag, body in obj {
		inner := body.(json.Object) or_return
		switch tag {
		case "A_ArrayExpr":
			return decode_A_ArrayExpr(inner, allocator), true
		case "A_Expr":
			return decode_A_Expr(inner, allocator), true
		case "A_Indices":
			return decode_A_Indices(inner, allocator), true
		case "A_Indirection":
			return decode_A_Indirection(inner, allocator), true
		case "A_Star":
			return decode_A_Star(inner, allocator), true
		case "AccessPriv":
			return decode_AccessPriv(inner, allocator), true
		case "AlterCollationStmt":
			return decode_AlterCollationStmt(inner, allocator), true
		case "AlterDatabaseRefreshCollStmt":
			return decode_AlterDatabaseRefreshCollStmt(inner, allocator), true
		case "AlterDatabaseSetStmt":
			return decode_AlterDatabaseSetStmt(inner, allocator), true
		case "AlterDatabaseStmt":
			return decode_AlterDatabaseStmt(inner, allocator), true
		case "AlterDefaultPrivilegesStmt":
			return decode_AlterDefaultPrivilegesStmt(inner, allocator), true
		case "AlterDomainStmt":
			return decode_AlterDomainStmt(inner, allocator), true
		case "AlterEnumStmt":
			return decode_AlterEnumStmt(inner, allocator), true
		case "AlterEventTrigStmt":
			return decode_AlterEventTrigStmt(inner, allocator), true
		case "AlterExtensionContentsStmt":
			return decode_AlterExtensionContentsStmt(inner, allocator), true
		case "AlterExtensionStmt":
			return decode_AlterExtensionStmt(inner, allocator), true
		case "AlterFdwStmt":
			return decode_AlterFdwStmt(inner, allocator), true
		case "AlterForeignServerStmt":
			return decode_AlterForeignServerStmt(inner, allocator), true
		case "AlterFunctionStmt":
			return decode_AlterFunctionStmt(inner, allocator), true
		case "AlterObjectDependsStmt":
			return decode_AlterObjectDependsStmt(inner, allocator), true
		case "AlterObjectSchemaStmt":
			return decode_AlterObjectSchemaStmt(inner, allocator), true
		case "AlterOpFamilyStmt":
			return decode_AlterOpFamilyStmt(inner, allocator), true
		case "AlterOperatorStmt":
			return decode_AlterOperatorStmt(inner, allocator), true
		case "AlterOwnerStmt":
			return decode_AlterOwnerStmt(inner, allocator), true
		case "AlterPolicyStmt":
			return decode_AlterPolicyStmt(inner, allocator), true
		case "AlterPublicationStmt":
			return decode_AlterPublicationStmt(inner, allocator), true
		case "AlterRoleSetStmt":
			return decode_AlterRoleSetStmt(inner, allocator), true
		case "AlterRoleStmt":
			return decode_AlterRoleStmt(inner, allocator), true
		case "AlterSeqStmt":
			return decode_AlterSeqStmt(inner, allocator), true
		case "AlterStatsStmt":
			return decode_AlterStatsStmt(inner, allocator), true
		case "AlterSubscriptionStmt":
			return decode_AlterSubscriptionStmt(inner, allocator), true
		case "AlterSystemStmt":
			return decode_AlterSystemStmt(inner, allocator), true
		case "AlterTSConfigurationStmt":
			return decode_AlterTSConfigurationStmt(inner, allocator), true
		case "AlterTSDictionaryStmt":
			return decode_AlterTSDictionaryStmt(inner, allocator), true
		case "AlterTableCmd":
