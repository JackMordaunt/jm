  "layout": [
    {
      "id": "base",
      "text": "The root is inline, fontFamilyBase at fontSizeBase300 and lineHeightBase300, fontWeightRegular, start-aligned, wrapping normally, overflow visible and clipped rather than ellipsised; it sets no colour, inheriting its parent's.",
      "tokens": [
        "tokens.fontFamilyBase",
        "tokens.fontSizeBase300",
        "tokens.lineHeightBase300",
        "tokens.fontWeightRegular"
      ],
      "source": "useTextStyles.styles.ts:15-26"
    },
    {
      "id": "nowrap",
      "text": "wrap false sets white-space nowrap with overflow hidden; truncate then adds an ellipsis, and does nothing while the text wraps.",
      "source": "useTextStyles.styles.ts:27-33,121-122"
    },
    {
      "id": "decoration",
      "text": "Underline and strikethrough are text-decoration lines; both together set 'line-through underline' so neither cancels the other.",
      "source": "useTextStyles.styles.ts:40-48,125-127"
    },
    {
      "id": "block",
      "text": "block makes the run display block, so align takes effect across the line box.",
      "source": "useTextStyles.styles.ts:34-36,100-108,123,142-144"
    },
    {
      "id": "presets",
      "text": "createPreset wraps useText and useTextStyles and appends the preset's own class, whose one rule is the typographyStyles entry, so a preset keeps every Text prop (block, italic, truncate, align).",
      "source": "createPreset.ts:9-28"
    }
  ],
  "states": [
    {
      "state": "enabled",
      "text": "Text has no interaction states; it draws in the colour it inherits.",
      "source": "useTextStyles.styles.ts:15-26"
    }
  ],
  "behaviour": [
    {
      "id": "static",
      "text": "Text neither takes input nor animates; an implementation shapes one run at the resolved style and draws it.",
      "motion": {
        "instant": true
      },
      "source": "useTextStyles.styles.ts:114-149"
    }
  ],
  "accessibility": {
    "role": "none",
    "minTargetPx": null,
    "keyboard": [],
    "semantics": [
      "renders as a span by default, or as the heading, paragraph, pre, strong, b, em or i element the caller chooses; the element carries the semantics, the styles do not"
    ]
  },
  "notes": [
    {
      "kind": "gotcha",
      "text": "Text sets no colour token: it inherits, so on a coloured surface the parent must set the foreground (a card sets colorNeutralForeground1, a brand button colorNeutralForegroundOnBrand). A renderer without inheritance passes the colour explicitly.",
      "tokens": [
        "tokens.colorNeutralForeground1",
        "tokens.colorNeutralForegroundOnBrand"
      ],
      "source": "useTextStyles.styles.ts:15-26"
    },
    {
      "kind": "hard-coded",
      "text": "Size 300 and weight regular add no class because the base already is them; every other size and weight is its own class over the base.",
      "source": "useTextStyles.styles.ts:128-141"
    },
    {
      "kind": "inferred",
      "text": "The preset style files carry digits in their names (useBody1Styles.styles.ts) and fall outside this kit's citation pattern; each is one rule, root: typographyStyles.<name>, read at the kit's commit and vendored under react-text/presets.",
      "source": "createPreset.ts:9-28"
    }
  ]
