        "400",
        "500",
        "600",
        "700",
        "800",
        "900",
        "1000"
      ],
      "required": false,
      "default": "300",
      "description": "A step on the size ramp: 100 to 600 read fontSizeBase<n> with lineHeightBase<n>, 700 to 1000 the Hero pairs."
    },
    {
      "name": "weight",
      "type": "enum",
      "values": [
        "regular",
        "medium",
        "semibold",
        "bold"
      ],
      "required": false,
      "default": "regular",
      "description": "The font weight token."
    },
    {
      "name": "font",
      "type": "enum",
      "values": [
        "base",
        "monospace",
        "numeric"
      ],
      "required": false,
      "default": "base",
      "description": "The family: fontFamilyBase, fontFamilyMonospace or fontFamilyNumeric."
    },
    {
      "name": "align",
      "type": "enum",
      "values": [
        "start",
        "center",
        "end",
        "justify"
      ],
      "required": false,
      "default": "start",
      "description": "Text alignment within the box; only visible when the text is block or wraps."
    },
    {
      "name": "block",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Lays the text out as a block that takes its own line instead of inline."
    },
    {
      "name": "italic",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Italic style."
    },
    {
      "name": "underline",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "An underline; with strikethrough both lines draw."
    },
    {
      "name": "strikethrough",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "A line through the text."
    },
    {
      "name": "truncate",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "With wrap false, ends an overflowing line with an ellipsis instead of clipping it."
    },
    {
      "name": "wrap",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "False keeps the text on one line and clips what overflows."
    }
  ],
