  "inputs": [
    {
      "name": "name",
      "type": "string",
      "required": false,
      "description": "The person's or entity's name: gives the initials, the colorful hash and the accessible name. Always supply it when known."
    },
    {
      "name": "image",
      "type": "slot",
      "required": false,
      "description": "An img covering the whole avatar; initials show while it loads or when absent."
    },
    {
      "name": "initials",
      "type": "slot",
      "required": false,
      "description": "Custom initials; by default derived from name. At size 16 only the first initial renders."
    },
    {
      "name": "icon",
      "type": "icon",
      "required": false,
      "description": "Shown when there is neither image nor initials; defaults to a person icon sized with the avatar."
    },
    {
      "name": "badge",
      "type": "slot",
      "required": false,
      "description": "A PresenceBadge (see badge.json) pinned to the bottom-right corner, with a transparent gap cut around it."
    },
    {
      "name": "size",
      "type": "enum",
      "values": [
        "16",
        "20",
        "24",
        "28",
        "32",
        "36",
        "40",
        "48",
        "56",
        "64",
        "72",
        "96",
        "120",
        "128"
      ],
      "required": false,
      "default": "32",
      "description": "Width and height in px. For another size, use the next smaller supported size and override width and height."
    },
    {
      "name": "shape",
      "type": "enum",
      "values": [
        "circular",
        "square"
      ],
      "required": false,
      "default": "circular",
      "description": "circular is a disc; square rounds its corners by a radius that grows with size."
    },
    {
      "name": "color",
      "type": "enum",
      "values": [
        "neutral",
        "brand",
        "colorful",
        "dark-red",
        "cranberry",
        "red",
        "pumpkin",
        "peach",
        "marigold",
        "gold",
        "brass",
        "brown",
        "forest",
        "seafoam",
        "dark-green",
        "light-teal",
        "teal",
        "steel",
        "blue",
        "royal-blue",
        "cornflower",
        "navy",
        "lavender",
        "purple",
        "grape",
        "lilac",
        "pink",
        "magenta",
        "plum",
        "beige",
        "mink",
        "platinum",
        "anchor"
      ],
      "required": false,
      "default": "neutral",
      "description": "Background and text of the initials or icon. neutral is grey; brand the static brand colour; colorful picks one of the 30 named colours by hashing name (or idForColor); a named colour pins one."
    },
    {
      "name": "idForColor",
      "type": "string",
      "required": false,
      "description": "Hashed instead of name to choose the colorful colour."
    },
    {
      "name": "active",
      "type": "enum",
      "values": [
        "unset",
        "active",
        "inactive"
      ],
      "required": false,
      "default": "unset",
      "description": "unset draws nothing extra; active adds the activeAppearance decoration; inactive shrinks and fades the avatar."
    },
    {
      "name": "activeAppearance",
      "type": "enum",
      "values": [
        "ring",
        "shadow",
        "ring-shadow"
      ],
      "required": false,
      "default": "ring",
      "description": "The decoration active shows: a ring outside the avatar, a shadow, or both."
    }
  ],
  "anatomy": [
    {
      "id": "root",
      "name": "Avatar",
      "description": "An inline-block box of the size, circular by default, holding one of image, initials or icon, and the ring (::before) and shadow (::after) layers behind them.",
      "tokens": [
        "tokens.borderRadiusCircular"
      ]
    },
    {
      "id": "image",
      "name": "Image",
      "description": "An img filling the root, object-fit cover, inheriting its radius.",
      "optional": true
    },
    {
      "id": "initials",
      "name": "Initials",
      "description": "Centred semibold letters on the colour's background, filling the root with a transparent strokeWidthThin border.",
      "optional": true,
      "tokens": [
        "tokens.fontWeightSemibold",
        "tokens.strokeWidthThin",
        "tokens.colorTransparentStroke"
      ]
    },
    {
      "id": "icon",
      "name": "Icon",
      "description": "A centred glyph on the colour's background, sized by the avatar's size; same box as the initials.",
      "optional": true
    },
    {
      "id": "ring",
      "name": "Active ring",
      "description": "A border of ringWidth drawn around the avatar with a ringWidth gap, in the colour's ring token, shown when active with ring or ring-shadow.",
      "optional": true
    },
    {
      "id": "shadow",
      "name": "Active shadow",
      "description": "A layer the avatar's shape casting a shadow token by size, shown when active with shadow or ring-shadow.",
      "optional": true
    },
    {
      "id": "badge",
      "name": "Presence badge",
      "description": "A PresenceBadge absolutely positioned at the bottom-right corner (bottom-left in RTL).",
      "optional": true
    }
  ],
