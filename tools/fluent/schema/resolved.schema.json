{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluent-kit.local/schema/resolved.schema.json",
  "title": "Fluent UI v9 resolved tokens",
  "description": "Every token flat, keyed by tokens.<name> as Fluent code spells it, with the value each theme gives it. value is webLightTheme; dark, highContrast, teamsLight and teamsDark appear where that theme differs. tier says global (a value) or alias (a role over the globals); alias names the global the light value came from, where the source shows one. typographyStyles.<name> are the composite text styles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "source",
    "modes",
    "units",
    "tokens"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "commit",
        "package",
        "version"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "modes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "units": {
      "type": "string"
    },
    "tokens": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(tokens|typographyStyles)\\.[A-Za-z0-9]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "tier": {
            "enum": [
              "global",
              "alias"
            ]
          },
          "type": {
            "enum": [
              "color",
              "dimension",
              "duration",
              "cubicBezier",
              "fontFamily",
              "fontWeight",
              "shadow",
              "typography"
            ]
          },
          "value": {
            "$ref": "#/$defs/value"
          },
          "dark": {
            "$ref": "#/$defs/value"
          },
          "highContrast": {
            "$ref": "#/$defs/value"
          },
          "teamsLight": {
            "$ref": "#/$defs/value"
          },
          "teamsDark": {
            "$ref": "#/$defs/value"
          },
          "alias": {
            "type": "string",
            "pattern": "^global\\.[A-Za-z0-9.]+$"
          },
          "tokens": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^tokens\\.[A-Za-z0-9]+$"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "color"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "$ref": "#/$defs/color"
                },
                "dark": {
                  "$ref": "#/$defs/color"
                },
                "highContrast": {
                  "$ref": "#/$defs/color"
                },
                "teamsLight": {
                  "$ref": "#/$defs/color"
                },
                "teamsDark": {
                  "$ref": "#/$defs/color"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "dimension",
                    "duration",
                    "fontWeight"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "number"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "cubicBezier"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "shadow"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "$ref": "#/$defs/shadow"
                },
                "dark": {
                  "$ref": "#/$defs/shadow"
                },
                "highContrast": {
                  "$ref": "#/$defs/shadow"
                },
                "teamsLight": {
                  "$ref": "#/$defs/shadow"
                },
                "teamsDark": {
                  "$ref": "#/$defs/shadow"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "typography"
                }
              }
            },
            "then": {
              "required": [
                "tokens"
              ],
              "properties": {
                "value": {
                  "type": "object",
                  "required": [
                    "fontFamily",
                    "fontWeight",
                    "fontSize",
                    "lineHeight"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "fontFamily": {
                      "type": "string"
                    },
                    "fontWeight": {
                      "type": "number"
                    },
                    "fontSize": {
                      "type": "number"
                    },
                    "lineHeight": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "value": {
      "type": [
        "number",
        "string",
        "array",
        "object"
      ]
    },
    "color": {
      "type": "string",
      "pattern": "^(#[0-9a-f]{6}|#[0-9a-f]{8})$",
      "description": "#rrggbb, or #rrggbbaa where the source keeps an alpha colour."
    },
    "shadow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "blur",
          "color"
        ],
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "blur": {
            "type": "number"
          },
          "color": {
            "$ref": "#/$defs/color"
          }
        }
      },
      "description": "Layers painted in order, ambient first; each is a CSS box-shadow with no spread."
    }
  }
}
